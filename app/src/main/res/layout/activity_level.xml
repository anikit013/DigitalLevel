<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <com.example.digitallevel.ui.DigitalLevelView
        android:id="@+id/levelView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvOverallTilt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Overall Tilt: 0.0°"
        android:textSize="18sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvXAngle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="X Angle: 0.0°"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/tvYAngle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Y Angle: 0.0°"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/tvLevelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Status: LEVEL"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvAmbientLight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Light: 0 lux"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvCalibrationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Calibration: None"
        android:textSize="16sp"
        android:layout_marginTop="4dp"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnSaveMeasurement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_measurement"/>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnCalibrate"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_calibrate"/>

        <Button
            android:id="@+id/btnResetCalibration"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/btn_reset_calibration"/>
    </LinearLayout>

</LinearLayout>